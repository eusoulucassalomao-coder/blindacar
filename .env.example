# Configure estas variáveis no painel da Vercel (Settings > Environment Variables). NÃO comite chaves reais.
SUPABASE_URL=https://nbvuvslfltzjuemrbhau.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # Supabase > Project Settings > API > service_role (SECRETA)
