STRIPE_PRICE_ID=                  # Stripe > Product catalog > preço único (price_...)
STRIPE_WEBHOOK_SECRET=            # Stripe > Webhooks > endpoint > Signing secret (whsec_...)
APP_URL=                          # opcional, ex.: https://blindacar.vercel.app
